# The Graph gateway API key.
# Every subgraph query (pools, auto-listing, margin module) sends this as a
# Bearer token. Without it the gateway replies "auth error: malformed API key"
# and the UI silently renders empty lists.
# Get one at https://thegraph.com/studio/apikeys/
NEXT_PUBLIC_AUTH_TOKEN_GQL=

# "development" | "production" — gates test networks and dev-only routes.
NEXT_PUBLIC_ENV=development

# Onramp widget (Onramper) application id. Optional for local development.
NEXT_PUBLIC_ONRAMP_APP_ID=

# Multisig / revenue contract addresses used by the portfolio pages.
NEXT_PUBLIC_MSIG_CONTRACT_ADDRESS=
NEXT_PUBLIC_REVENUE_CONTRACT_ADDRESS=

# Server-side only: SimpleSwap API key used by the cross-chain swap route.
SIMPLE_SWAP_API_KEY=

# Local anvil fork RPC. Set only for local fork testing; leave unset otherwise.
# NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545
